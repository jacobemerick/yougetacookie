# Pages serves HTML as must-revalidate by default.

/images/*
  Cache-Control: public, max-age=604800

/styles/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'none'; script-src 'sha256-Vo5Qqbp2v2UAlfBYdCB6PWtucSkFpydnII1CpCifU3o=' https://static.cloudflareinsights.com/beacon.min.js; connect-src https://cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
